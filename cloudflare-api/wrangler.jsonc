{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klirline-social-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klirline-social",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "klirline-social-media" }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://app.klirline.com",
    "PUBLIC_BASE_URL": "https://api.klirline.com",
    "META_GRAPH_VERSION": "v26.0",
    "THREADS_API_VERSION": "v1.0",
    "THREADS_APP_ID": "",
    "THREADS_REDIRECT_URI": "https://api.klirline.com/oauth/threads/callback",
    "X_CLIENT_ID": "",
    "X_REDIRECT_URI": "https://api.klirline.com/oauth/x/callback",
    "PINTEREST_APP_ID": "",
    "PINTEREST_REDIRECT_URI": "https://api.klirline.com/oauth/pinterest/callback",
    "LINKEDIN_VERSION": "202610",
    "FACEBOOK_PAGE_ID": "",
    "LINKEDIN_ORGANIZATION_URN": "",
    "LINKEDIN_ORGANIZATION_NAME": "",
    "META_APP_ID": "",
    "ALLOW_PUBLIC_SIGNUP": "false",
    "INTERNAL_MODE": "true",
    "REQUIRE_APPROVED_DRAFTS": "true",
    "PLAN_MAX_ACCOUNTS": "9",
    "PLAN_MONTHLY_POST_LIMIT": "5000",
    "INSTAGRAM_REDIRECT_URI": "https://api.klirline.com/oauth/instagram/callback",
    "FACEBOOK_REDIRECT_URI": "https://api.klirline.com/oauth/facebook/callback",
    "LINKEDIN_CLIENT_ID": "",
    "LINKEDIN_REDIRECT_URI": "https://api.klirline.com/oauth/linkedin/callback",
    "COMPANY_LEGAL_NAME": "Klirline Inc.",
    "PRIVACY_CONTACT_EMAIL": "contact@klirline.ca"
  }
}
