# Exemple — NE JAMAIS commiter de vrais secrets. Copier vers .env sur le serveur.
PORT=8787
PUBLIC_BASE_URL=https://social.example.com
FRONTEND_ORIGIN=https://app.klirline.com
JWT_SECRET=changez-moi-64-caracteres-minimum
# Cle bootstrap du premier administrateur (32 caracteres minimum, a conserver hors du dépôt)
BOOTSTRAP_ADMIN_KEY=changez-cette-cle-bootstrap-aleatoire
COMPANY_LEGAL_NAME=
PRIVACY_CONTACT_EMAIL=
# Cle 32 octets hex (64 caracteres hex) pour chiffrer les tokens OAuth au repos (AES-256-GCM)
TOKENS_ENCRYPTION_KEY_HEX=
DATA_DIR=./data
MEDIA_DIR=./data/media
MEDIA_PUBLIC_PREFIX=/media

# Renseigner au fur et a mesure des apps creees chez chaque fournisseur.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.votredomaine.com/oauth/instagram/callback
FACEBOOK_REDIRECT_URI=https://api.votredomaine.com/oauth/facebook/callback
THREADS_REDIRECT_URI=https://api.votredomaine.com/oauth/threads/callback
META_GRAPH_VERSION=v26.0
THREADS_API_VERSION=v1.0
FACEBOOK_PAGE_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_DEFAULT_BOARD_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
BLUESKY_REDIRECT_URI=
BLUESKY_CLIENT_METADATA_URL=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_VERSION=
# Chaque redirect = PUBLIC_BASE_URL + /oauth/<provider>/callback
